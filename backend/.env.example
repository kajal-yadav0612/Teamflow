# Production / Railway: use MongoDB Atlas or Railway MongoDB plugin URL
# DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/team_task_manager?retryWrites=true&w=majority"

# Local: run `npm run dev` — starts in-memory MongoDB automatically (no install needed)
DATABASE_URL="mongodb://localhost:27017/team_task_manager"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
